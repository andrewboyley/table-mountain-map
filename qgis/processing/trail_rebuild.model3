        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="clip"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="SQL" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="SELECT &quot;osm_id&quot;,&quot;name&quot;,&quot;highway&quot;,&quot;waterway&quot;,&quot;aerialway&quot;,&quot;barrier&quot;,&quot;man_made&quot;,&quot;railway&quot;,&quot;z_order&quot;,&quot;other_tags&quot;,&#xa;       ST_Multi(ST_CollectionExtract(geom, 2)) AS geom&#xa;FROM &quot;lines&quot;"/>
          </Option>
        </Option>
      </Option>
    </Option>
