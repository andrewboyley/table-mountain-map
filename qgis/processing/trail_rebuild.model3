<!DOCTYPE model>
<Option type="Map">
  <Option name="children" type="Map">
    <Option name="clip" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="gdal:clipvectorbypolygon"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="0"/>
        <Option name="component_pos_y" type="double" value="0"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="false"/>
        <Option name="parameters_collapsed" type="bool" value="false"/>
      </Option>
      <Option name="component_description" type="QString" value="Clip OSM lines to boundary (WGS84)"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="300"/>
      <Option name="component_pos_y" type="double" value="50"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="clip"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="false"/>
      <Option name="parameters_collapsed" type="bool" value="false"/>
      <Option name="params" type="Map">
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="expression" type="QString" value="@INPUT_PBF || '|layername=lines'"/>
            <Option name="source" type="int" value="3"/>
          </Option>
        </Option>
        <Option name="MASK" type="List">
          <Option type="Map">
            <Option name="parameter_name" type="QString" value="INPUT_BOUNDARY"/>
            <Option name="source" type="int" value="0"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="dissolve" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="gdal:executesql"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="0"/>
        <Option name="component_pos_y" type="double" value="0"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="false"/>
        <Option name="parameters_collapsed" type="bool" value="false"/>
      </Option>
      <Option name="component_description" type="QString" value="Dissolve named ways per OSM name with deterministic aggregates (n_ways, osm_ids sorted, highway first-seen order, n_parts, length_m)"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="2550"/>
      <Option name="component_pos_y" type="double" value="50"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="dissolve"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="false"/>
      <Option name="parameters_collapsed" type="bool" value="false"/>
      <Option name="params" type="Map">
        <Option name="DIALECT" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="2"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="sort_named"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="SQL" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="SELECT r.name,&#xa;       COUNT(*) AS n_ways,&#xa;       (SELECT GROUP_CONCAT(osm_id)&#xa;        FROM (SELECT osm_id FROM &quot;INPUT&quot; AS w&#xa;              WHERE w.name = r.name&#xa;              ORDER BY CAST(w.osm_id AS INTEGER))) AS osm_ids,&#xa;       (SELECT GROUP_CONCAT(highway, ';')&#xa;        FROM (SELECT highway&#xa;              FROM (SELECT highway, MIN(CAST(w.osm_id AS INTEGER)) AS m&#xa;                    FROM &quot;INPUT&quot; AS w&#xa;                    WHERE w.name = r.name&#xa;                    GROUP BY highway)&#xa;              ORDER BY m)) AS highway,&#xa;       ST_Multi(ST_CollectionExtract(ST_Union(geom), 2)) AS geom,&#xa;       ST_NumGeometries(ST_CollectionExtract(ST_Union(geom), 2)) AS n_parts,&#xa;       ROUND(ST_Length(ST_CollectionExtract(ST_Union(geom), 2)), 1) AS length_m&#xa;FROM &quot;INPUT&quot; AS r&#xa;GROUP BY r.name&#xa;ORDER BY r.name"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="dissolved_name" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:extractbyexpression"/>
