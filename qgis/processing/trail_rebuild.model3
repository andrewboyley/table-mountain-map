  <Option name="designerParameterValues"/>
  <Option name="groupBoxes"/>
  <Option name="help" type="Map">
    <Option name="ALG_DESC" type="QString" value="Rebuild the named, dissolved and supplement trail datasets from an OSM extract and the park boundary. Clip in WGS84, drop clip-tangent point pieces and promote to MultiLineString, reproject to EPSG:32734, split by highway/name, sort every output by osm_id, dissolve named ways with deterministic aggregates, and write three GeoPackages with their canonical layer names. Deterministic regardless of input feature order."/>
  </Option>
