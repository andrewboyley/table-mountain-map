<!DOCTYPE model>
<Option type="Map">
  <Option name="children" type="Map">
    <Option name="canonical" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:fieldcalculator"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="0"/>
        <Option name="component_pos_y" type="double" value="0"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="false"/>
        <Option name="parameters_collapsed" type="bool" value="false"/>
      </Option>
      <Option name="component_description" type="QString" value="Fold spelling variants onto the canonical name"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="550"/>
      <Option name="component_pos_y" type="double" value="50"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="canonical"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="false"/>
      <Option name="parameters_collapsed" type="bool" value="false"/>
      <Option name="params" type="Map">
        <Option name="FIELD_LENGTH" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="80"/>
          </Option>
        </Option>
        <Option name="FIELD_NAME" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="canonical_name"/>
          </Option>
        </Option>
        <Option name="FIELD_PRECISION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="FIELD_TYPE" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="2"/>
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="CASE WHEN &quot;name&quot; = &#x27;Shortcut to Elephants Eye&#x27; THEN &#x27;Elephant&#x27;&#x27;s Eye Trail&#x27; WHEN &quot;name&quot; = &#x27;Smuts&#x27;&#x27; Track&#x27; THEN &#x27;Skeleton Gorge / Smuts Track&#x27; WHEN &quot;name&quot; = &#x27;Yellowwood Trail / Smuts Track&#x27; THEN &#x27;Skeleton Gorge / Smuts Track&#x27; ELSE &quot;name&quot; END"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="official_extract"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="OUTPUT" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="memory:official_canonical"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="dissolve" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="gdal:executesql"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="0"/>
        <Option name="component_pos_y" type="double" value="0"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="false"/>
        <Option name="parameters_collapsed" type="bool" value="false"/>
      </Option>
      <Option name="component_description" type="QString" value="Dissolve by canonical_name"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="1050"/>
      <Option name="component_pos_y" type="double" value="50"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="dissolve"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="false"/>
      <Option name="parameters_collapsed" type="bool" value="false"/>
      <Option name="params" type="Map">
        <Option name="DIALECT" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="int" value="2"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="sort"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="1"/>
          </Option>
        </Option>
        <Option name="SQL" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="SELECT r.canonical_name AS name,&#xa;       COUNT(*) AS n_ways,&#xa;       (SELECT GROUP_CONCAT(osm_id)&#xa;        FROM (SELECT osm_id FROM &quot;INPUT&quot; AS w&#xa;              WHERE w.canonical_name = r.canonical_name&#xa;              ORDER BY CAST(w.osm_id AS INTEGER))) AS osm_ids,&#xa;       (SELECT GROUP_CONCAT(highway, &#x27;;&#x27;)&#xa;        FROM (SELECT highway&#xa;              FROM (SELECT highway, MIN(CAST(w.osm_id AS INTEGER)) AS m&#xa;                    FROM &quot;INPUT&quot; AS w&#xa;                    WHERE w.canonical_name = r.canonical_name&#xa;                    GROUP BY highway)&#xa;              ORDER BY m)) AS highway,&#xa;       ST_Multi(ST_CollectionExtract(ST_Union(geom), 2)) AS geom,&#xa;       ST_NumGeometries(ST_CollectionExtract(ST_Union(geom), 2)) AS n_parts,&#xa;       ROUND(ST_Length(ST_CollectionExtract(ST_Union(geom), 2)), 1) AS length_m&#xa;FROM &quot;INPUT&quot; AS r&#xa;GROUP BY r.canonical_name&#xa;ORDER BY r.canonical_name"/>
          </Option>
        </Option>
      </Option>
    </Option>
    <Option name="official_extract" type="Map">
      <Option name="active" type="bool" value="true"/>
      <Option name="alg_config"/>
      <Option name="alg_id" type="QString" value="native:extractbyexpression"/>
      <Option name="color" type="QString" value=""/>
      <Option name="comment" type="Map">
        <Option name="color" type="QString" value=""/>
        <Option name="component_description" type="QString" value=""/>
        <Option name="component_height" type="double" value="60"/>
        <Option name="component_pos_x" type="double" value="0"/>
        <Option name="component_pos_y" type="double" value="0"/>
        <Option name="component_width" type="double" value="100"/>
        <Option name="outputs_collapsed" type="bool" value="false"/>
        <Option name="parameters_collapsed" type="bool" value="false"/>
      </Option>
      <Option name="component_description" type="QString" value="Keep only allowlisted official OSM names"/>
      <Option name="component_height" type="double" value="30"/>
      <Option name="component_pos_x" type="double" value="300"/>
      <Option name="component_pos_y" type="double" value="50"/>
      <Option name="component_width" type="double" value="200"/>
      <Option name="dependencies"/>
      <Option name="id" type="QString" value="official_extract"/>
      <Option name="outputs"/>
      <Option name="outputs_collapsed" type="bool" value="false"/>
      <Option name="parameters_collapsed" type="bool" value="false"/>
      <Option name="params" type="Map">
        <Option name="EXPRESSION" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="&quot;name&quot; IN (&#x27;Cape Point&#x27;, &#x27;Cape of Good Hope&#x27;, &#x27;Cecilia Ridge&#x27;, &#x27;Contour Path&#x27;, &#x27;Disa Gorge&#x27;, &#x27;Echo Valley&#x27;, &#x27;Elephant&#x27;&#x27;s Eye Trail&#x27;, &#x27;Hoerikwaggo Trail&#x27;, &#x27;India Venster&#x27;, &#x27;Karbonkelberg Traverse&#x27;, &#x27;Kasteelspoort Path&#x27;, &#x27;Kloof Corner&#x27;, &#x27;Lighthouse Keeper&#x27;&#x27;s Trail&#x27;, &#x27;Lions Head Path&#x27;, &#x27;Newlands Ravine&#x27;, &#x27;Nursery Ravine&#x27;, &#x27;Orange Kloof Trail&#x27;, &#x27;Pipe Track&#x27;, &#x27;Platteklip Gorge&#x27;, &#x27;Rooikrans Trail&#x27;, &#x27;Shipwreck Trail&#x27;, &#x27;Shortcut to Elephants Eye&#x27;, &#x27;Skeleton Gorge / Smuts Track&#x27;, &#x27;Smuts&#x27;&#x27; Track&#x27;, &#x27;Suther Peak&#x27;, &#x27;Twelve Apostles Path&#x27;, &#x27;Yellowwood Trail / Smuts Track&#x27;)"/>
          </Option>
        </Option>
        <Option name="INPUT" type="List">
          <Option type="Map">
            <Option name="parameter_name" type="QString" value="INPUT_NAMED"/>
            <Option name="output_name" type="QString" value="OUTPUT"/>
            <Option name="source" type="int" value="0"/>
          </Option>
        </Option>
        <Option name="OUTPUT" type="List">
          <Option type="Map">
            <Option name="source" type="int" value="2"/>
            <Option name="static_value" type="QString" value="memory:official_named"/>
          </Option>
        </Option>
      </Option>
    </Option>
