          <Option type="Map">
            <Option name="source" type="int" value="2" />
            <Option name="static_value" type="int" value="1" />
          </Option>
        </Option>
        <Option name="FORMULA" type="List">
          <Option type="Map">
            <Option name="expression" type="QString" value="'(A &lt; ' || @SHADOW_MAX || ') * 1 + (A &gt;= ' || @SHADOW_MAX || ') * (A &lt; ' || @MID_MAX || ') * 2 + (A &gt;= ' || @MID_MAX || ') * 3'" />
            <Option name="source" type="int" value="3" />
          </Option>
        </Option>
        <Option name="INPUT_A" type="List">
          <Option type="Map">
            <Option name="child_id" type="QString" value="coarse" />
