      <Option name="component_description" type="QString" value="Three mutually exclusive class codes 1/2/3, Byte output, 0 is NoData" />
      <Option name="component_height" type="double" value="30" />
      <Option name="component_pos_x" type="double" value="550" />
      <Option name="component_pos_y" type="double" value="50" />
