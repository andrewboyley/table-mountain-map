      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="metadata" />
      <Option name="name" type="QString" value="COMPUTE_EDGES" />
      <Option name="parameter_type" type="QString" value="boolean" />
    </Option>
    <Option name="EIGHT_CONNECTEDNESS" type="Map">
      <Option name="default" type="bool" value="false" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Polygonize with 8-connectivity" />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="metadata" />
      <Option name="name" type="QString" value="EIGHT_CONNECTEDNESS" />
      <Option name="parameter_type" type="QString" value="boolean" />
    </Option>
    <Option name="INPUT" type="Map">
      <Option name="default" type="invalid" />
      <Option name="defaultGui" type="invalid" />
