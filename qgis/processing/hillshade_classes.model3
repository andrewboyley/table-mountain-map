      <Option name="name" type="QString" value="INPUT" />
      <Option name="parameter_type" type="QString" value="raster" />
    </Option>
    <Option name="MID_MAX" type="Map">
      <Option name="data_type" type="int" value="0" />
      <Option name="default" type="int" value="192" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Class 2 upper bound, exclusive (midtone)" />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="MID_MAX" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
    <Option name="SHADOW_MAX" type="Map">
      <Option name="data_type" type="int" value="0" />
      <Option name="default" type="int" value="128" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Class 1 upper bound, exclusive (shadow)" />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="SHADOW_MAX" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
    <Option name="SIEVE_PIXELS" type="Map">
      <Option name="data_type" type="int" value="1" />
      <Option name="default" type="int" value="16" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Absorb class regions smaller than this many pixels; 0 keeps every region. A pixel here is a COARSE_RES cell, not a source pixel." />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="SIEVE_PIXELS" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
    <Option name="SIMPLIFY_TOLERANCE" type="Map">
      <Option name="data_type" type="int" value="0" />
      <Option name="default" type="double" value="20" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Tolerance in metres for dropping surplus vertices after smoothing. Chaikin multiplies the vertex count by about sixteen, so a tolerance near a quarter of COARSE_RES cuts the file size with no visible change to the curve." />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="SIMPLIFY_TOLERANCE" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
    <Option name="SMOOTH_ITERATIONS" type="Map">
      <Option name="data_type" type="int" value="1" />
      <Option name="default" type="double" value="12" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Chaikin passes over each boundary. The pass count is what pulls the boundary off the pixel grid, and it saturates: past a dozen or so more passes add nothing." />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="SMOOTH_ITERATIONS" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
    <Option name="SMOOTH_MAX_ANGLE" type="Map">
      <Option name="data_type" type="int" value="0" />
      <Option name="default" type="double" value="180" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Do not smooth nodes whose angle exceeds this; 180 smooths everything" />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="SMOOTH_MAX_ANGLE" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
    <Option name="SMOOTH_OFFSET" type="Map">
      <Option name="data_type" type="int" value="0" />
      <Option name="default" type="double" value="0.03" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Corner cutting, 0 to 0.5. The area a pass removes goes as the square of this, so a small offset over many passes rounds a boundary as well as a large offset over few passes, at a fraction of the area cost." />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="max" type="double" value="1.7976931348623157e+308" />
      <Option name="metadata" />
      <Option name="min" type="double" value="-1.7976931348623157e+308" />
      <Option name="name" type="QString" value="SMOOTH_OFFSET" />
      <Option name="parameter_type" type="QString" value="number" />
    </Option>
