            <Option name="static_value" type="QString" value="memory:peaks_sorted" />
          </Option>
        </Option>
      </Option>
    </Option>
  </Option>
  <Option name="help" type="Map">
    <Option name="ALG_DESC" type="QString" value="Build the named-summits dataset from an OSM peak extract. Keep only natural=peak features that carry both a non-blank name and a non-blank ele, reproject to EPSG:32734, sort by osm_id so the output is deterministic regardless of input order, and write a single GeoPackage whose layer is named summits. Read the input with osmium rather than the GDAL OSM driver: that driver silently drops the ele tag from both its field list and other_tags, so peaks read through it arrive with no elevation." />
  </Option>
  <Option name="internal_version" type="QString" value="Version2" />
  <Option name="modelVariables" />
  <Option name="model_group" type="QString" value="Peak" />
  <Option name="model_name" type="QString" value="peak_extract" />
  <Option name="outputGroup" type="QString" value="" />
  <Option name="outputOrder" />
  <Option name="parameterDefinitions" type="Map">
    <Option name="INPUT_PEAKS" type="Map">
      <Option name="behavior" type="int" value="0" />
      <Option name="default" type="invalid" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="Peak points written by osmium (GeoJSON/GeoPackage carrying name, ele and osm_id)" />
      <Option name="extension" type="QString" value="" />
      <Option name="filefilter" type="QString" value="All files (*.*)" />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="metadata" />
      <Option name="name" type="QString" value="INPUT_PEAKS" />
      <Option name="parameter_type" type="QString" value="file" />
    </Option>
    <Option name="output_peaks" type="Map">
      <Option name="create_by_default" type="bool" value="true" />
      <Option name="default" type="invalid" />
      <Option name="defaultGui" type="invalid" />
      <Option name="description" type="QString" value="OUTPUT_PEAKS" />
      <Option name="file_filter" type="QString" value="GeoPackage files (*.gpkg)" />
      <Option name="flags" type="int" value="0" />
      <Option name="help" type="QString" value="" />
      <Option name="metadata" type="Map">
        <Option name="_modelChildId" type="QString" value="package" />
        <Option name="_modelChildOutputName" type="QString" value="OUTPUT" />
        <Option name="_modelChildProvider" type="QString" value="native" />
        <Option name="widget_wrapper" type="Map">
          <Option name="dontconfirmoverwrite" type="bool" value="true" />
