{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "qgis": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "https://github.com/nkarasiak/qgis-mcp/archive/refs/heads/main.zip",
          "qgis-mcp-server"
        ]
      },
      "blender": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-for-blender==2.1.0",
          "--port",
          "9877"
        ]
      }
    }
  }
}